  m_Script: {fileID: 11500000, guid: 2458ccd072b3dd64c8b74895f29c98cc, type: 3}
  m_Name: SakuEncounter
  m_EditorClassIdentifier: Assembly-CSharp::Yobitsugi.VisualNovel.VNScene
  sceneId: 
  lines:
  - speaker: "\u30B5\u30AF"
    text: "\u304A\u3044\u304A\u3044\u3001\u3053\u3093\u306A\u6642\u9593\u306B\u3046\u308D\u3064\u3044\u3066\u308B\u306E\u306F\u3042\u3093\u305F\u304C\u521D\u3081\u3066\u3060\u3002"
    background: {fileID: 0}
    choices: []
  - speaker: "\u30B5\u30AF"
    text: "\u3053\u306E\u753A\u3001\u51FA\u53E3\u304C\u898B\u3064\u304B\u308B\u307E\u3067\u306F\u4F55\u5EA6\u3082\u540C\u3058\u5834\u6240\u306B\u623B\u3055\u308C\u308B\u3002"
    background: {fileID: 0}
    choices: []
  - speaker: "\u30DF\u30AA"
    text: "\u2026\u2026\u3042\u306A\u305F\u3082\u3001\u9589\u3058\u8FBC\u3081\u3089\u308C\u3066\u308B\u306E?"
    background: {fileID: 0}
    choices:
    - text: "\u300C\u624B\u4F1D\u3063\u3066\u304F\u308C\u308B\u306E?\u300D"
      nextLineIndex: 3
    - text: "\u300C\u4E00\u4EBA\u3067\u5927\u4E08\u592B\u300D"
      nextLineIndex: 4
  - speaker: "\u30B5\u30AF"
    text: "\u624B\u304C\u304B\u308A\u30923\u3064\u96C6\u3081\u308C\u3070\u3001\u9375\u306E\u304B\u304B\u3063\u305F\u5834\u6240\u304C\u958B\u304F\u306F\u305A\u3060\u3002\u624B\u4F1D\u3046\u3088\u3002"
    background: {fileID: 0}
    choices: []
  - speaker: "\u30B5\u30AF"
    text: "\u2026\u2026\u307E\u3042\u3001\u7121\u7406\u306F\u3059\u308B\u306A\u3088\u3002\u4F55\u304B\u3042\u3063\u305F\u3089\u96A0\u308C\u308B\u5834\u6240\u304F\u3089\u3044\u306F\u6559\u3048\u3068\u304F\u3002"
    background: {fileID: 0}
    choices: []
  nextScene: {fileID: 0}
